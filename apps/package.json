{
  "name": "@dw/app",
  "version": "0.1.0",
  "description": "DataWorkbench desktop app (Electron + Vue)",
  "author": "DataWorkbench contributors",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "pack:portable": "electron-vite build && electron-builder --dir --config electron-builder.yml",
    "pack:win": "electron-vite build && electron-builder --win --config electron-builder.yml",
    "preview": "electron-vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@dw/chart-core": "workspace:*",
    "@dw/rpc-types": "workspace:*",
    "@element-plus/icons-vue": "^2.3.2",
    "@mlightcad/ribbon": "^0.1.13",
    "@vue-flow/background": "^1.3.2",
    "@vue-flow/controls": "^1.1.3",
    "@vue-flow/core": "^1.48.2",
    "ag-grid-community": "^36.1.0",
    "ag-grid-vue3": "^36.1.0",
    "apache-arrow": "^21.2.0",
    "dompurify": "^3.4.15",
    "element-plus": "^2.9.0",
    "fflate": "^0.8.2",
    "golden-layout": "^2.6.0",
    "marked": "^18.0.12",
    "pinia": "^2.3.0",
    "uplot": "^1.6.32",
    "vue": "^3.5.13",
    "vue-i18n": "^11.1.2"
  },
  "devDependencies": {
    "@types/dompurify": "^3.2.0",
    "@types/node": "^22.10.2",
    "@vitejs/plugin-vue": "^5.2.1",
    "electron": "^33.3.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.7.2",
    "vite": "^5.4.11",
    "vitest": "^2.1.8"
  }

{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "preserve",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "paths": {
      "@/*": ["./src/*"],
      "@dw/rpc-types": ["../packages/rpc-types/src/index.ts"],
      "@dw/chart-core": ["../packages/chart-core/src/index.ts"]
    }
  },
  "include": ["electron/**/*.ts", "src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts"]
}

# Auth/registry only. Other pnpm settings live in pnpm-workspace.yaml (pnpm 12).
# Electron 33's npm package may omit checksums.json; without this, postinstall throws
# Cannot find module './checksums.json' and dist/electron.exe is never downloaded.
electron_use_remote_checksums=true
# GitHub releases are often unreachable; npmmirror hosts the same win32-x64 zip.
electron_mirror=https://npmmirror.com/mirrors/electron/
